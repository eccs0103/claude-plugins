{
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup|resume|clear|compact|fork",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject.mjs\" SessionStart",
						"timeout": 5,
						"statusMessage": "Loading product decisions..."
					}
				]
			}
		],
		"SubagentStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject.mjs\" SubagentStart",
						"timeout": 5,
						"statusMessage": "Loading product decisions..."
					}
				]
			}
		]
	}
}
